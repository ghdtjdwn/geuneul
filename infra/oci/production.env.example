# Copy to a mode-0600 file outside the release directory. Values below are
# placeholders only; never commit the populated file.

# Release and private host binding (Caddy on the same OCI VM proxies this port).
APP_IMAGE_TAG=0000000000000000000000000000000000000000
COMPOSE_PROJECT_NAME=geuneul
GEUNEUL_BIND_ADDRESS=10.0.0.9
GEUNEUL_APP_PORT=13880

# PostgreSQL. The application user is fixed to geuneul_app and is not superuser.
POSTGRES_ADMIN_PASSWORD=replace-with-random-64-byte-value
DB_PASSWORD=replace-with-a-different-random-64-byte-value

# Session and BFF trust boundary.
JWT_SECRET=replace-with-random-64-byte-value
GEUNEUL_PROXY_SECRET=replace-with-random-64-byte-value
JWT_EXPIRATION_HOURS=168

# OAuth and external providers.
KAKAO_REST_API_KEY=replace-with-secret
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=replace-with-client-id
GOOGLE_CLIENT_SECRET=replace-with-secret
KMA_SERVICE_KEY=replace-with-secret
DATA_GO_KR_SERVICE_KEY=replace-with-secret
SAFETYDATA_SERVICE_KEY=replace-with-secret
AI_SUMMARY_API_KEY=replace-with-secret
AI_SUMMARY_BASE_URL=https://api.mistral.ai/v1
AI_SUMMARY_MODEL=mistral-small-latest

# OCI Object Storage S3 compatibility API. Use the path-style dedicated endpoint.
S3_BUCKET_NAME=geuneul-photos
S3_REGION=ap-chuncheon-1
S3_ENDPOINT=https://namespace.compat.objectstorage.ap-chuncheon-1.oci.customer-oci.com
S3_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
S3_LEGACY_BASE_URLS=https://legacy-bucket.s3.ap-northeast-2.amazonaws.com
S3_BROWSER_UPLOAD_PROXY_BASE_URL=https://api.example.com/object-storage
AWS_ACCESS_KEY_ID=replace-with-oci-customer-access-key
AWS_SECRET_ACCESS_KEY=replace-with-oci-customer-secret-key

# Optional features copied from the current AWS SSM values during migration.
PUSH_ENABLED=false
PUSH_VAPID_PUBLIC_KEY_PEM=
PUSH_VAPID_PRIVATE_KEY_PEM=
PUSH_VAPID_SUBJECT=
GEUNEUL_REALTIME_ENABLED=true
PHOTO_CLEANUP_ENABLED=true
SPRINGDOC_ENABLED=false
OTEL_TRACING_EXPORT_ENABLED=false
OTEL_METRICS_EXPORT_ENABLED=false

# Off-host logical backups in a separate private Object Storage bucket.
BACKUP_BUCKET_NAME=geuneul-backups
BACKUP_RETENTION_DAYS=14
LOCAL_BACKUP_RETENTION_DAYS=3
BACKUP_AWS_ACCESS_KEY_ID=replace-with-separate-backup-writer-access-key
BACKUP_AWS_SECRET_ACCESS_KEY=replace-with-separate-backup-writer-secret-key
